# Copie para .env (o .env não vai para o git).

# 1440 = modo normal (24 h). De 1 a 1439 = demonstração.
LEMBRETE_ANTECEDENCIA_MINUTOS=1440
ROTINA_ENVIO_INTERVALO_MS=5000
ENVIO_MAX_TENTATIVAS=3

# Canal de envio: "whatsapp" (Meta Cloud API) ou "log" (envio simulado).
# Sem credenciais, o serviço cai para "log".
CANAL_ENVIO=log

# WhatsApp Business Cloud API (Graph API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v21.0
# US-15: no envio real, só estes telefones de teste recebem mensagem (com DDD, separados por vírgula).
# Vazio bloqueia todo envio real; "*" libera qualquer destino (não use com dados fictícios).
WHATSAPP_DESTINOS_PERMITIDOS=
# Reserva de envio mais antiga que isso (ms) é de uma chamada interrompida: vira "envio sem confirmação".
ENVIO_RESERVA_EXPIRA_MS=60000

# Portas publicadas no host (padrão entre parênteses). Mude só para rodar um segundo
# ambiente em paralelo, por exemplo o roteiro de ambiente limpo (npm run ambiente:limpo).
# RECEPCAO_PORTA=8080
# AGENDAMENTO_PORTA=3001
# NOTIFICACAO_PORTA=3002
# CADASTRO_PORTA=3003
# RABBITMQ_PORTA=5672
# RABBITMQ_PAINEL_PORTA=15672
# DB_AGENDAMENTO_PORTA=5433
# DB_NOTIFICACAO_PORTA=5434
# DB_CADASTRO_PORTA=5435
# Rotas /operacao da Notificação (inspeção e reprocessamento da fila de erros). Só para demonstração.
OPERACAO_HABILITADA=true
