# Copie para .env (o .env não vai para o git).

# Antecedência do lembrete em minutos. Padrão 1440 (24h); na demonstração, use 1.
LEMBRETE_ANTECEDENCIA_MINUTOS=1440

# Canal de envio: "whatsapp" (Meta Cloud API) ou "log" (envio simulado).
# Sem credenciais, o serviço cai para "log".
CANAL_ENVIO=log

# WhatsApp Business Cloud API (Graph API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v21.0
