# Copie para .env (o .env não vai para o git).

# Antecedência do lembrete em minutos. Padrão 1440 (24h); na demonstração, use 1.
LEMBRETE_ANTECEDENCIA_MINUTOS=1440

# Canal de envio: "whatsapp" (Meta Cloud API) ou "log" (envio simulado).
# Sem credenciais, o serviço cai para "log".
CANAL_ENVIO=log

# WhatsApp Business Cloud API (Graph API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v21.0

# Portas publicadas no host (padrão entre parênteses). Mude só para rodar um segundo
# ambiente em paralelo, por exemplo o roteiro de ambiente limpo (npm run ambiente:limpo).
# RECEPCAO_PORTA=8080
# AGENDAMENTO_PORTA=3001
# NOTIFICACAO_PORTA=3002
# CADASTRO_PORTA=3003
# RABBITMQ_PORTA=5672
# RABBITMQ_PAINEL_PORTA=15672
# DB_AGENDAMENTO_PORTA=5433
# DB_NOTIFICACAO_PORTA=5434
# DB_CADASTRO_PORTA=5435
