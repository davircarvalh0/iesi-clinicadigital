PORTA=3002
DATABASE_URL=postgresql://notificacao:notificacao@localhost:5434/notificacao
RABBITMQ_URL=amqp://clinica:clinica@localhost:5672
# 1440 = modo normal (24 h). De 1 a 1439 = demonstração.
LEMBRETE_ANTECEDENCIA_MINUTOS=1440
ROTINA_ENVIO_INTERVALO_MS=5000
CONSUMIDOR_MAX_TENTATIVAS=3
ENVIO_MAX_TENTATIVAS=3
CANAL_ENVIO=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v21.0
# US-15: no envio real, só estes telefones de teste recebem mensagem (com DDD, separados por vírgula).
# Vazio bloqueia todo envio real; "*" libera qualquer destino (não use com dados fictícios).
WHATSAPP_DESTINOS_PERMITIDOS=
# Reserva de envio mais antiga que isso (ms) é de uma chamada interrompida: vira "envio sem confirmação".
ENVIO_RESERVA_EXPIRA_MS=60000
OPERACAO_HABILITADA=true
