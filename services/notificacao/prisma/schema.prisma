generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusLembrete {
  programado
  /// US-11: reservado pela rotina de envio enquanto o canal está sendo chamado.
  enviando
  enviado
  simulado
  aceito_provedor
  falhou
  cancelado
  /// Sem autorização de contato no canal (desconhecida ou revogada) no momento do envio.
  bloqueado
}

enum ModoEnvio {
  simulado
  real
}

enum CanalLembrete {
  log
  whatsapp
}

/// Cópia local dos dados de contato necessários ao envio (vindos do evento, sem conteúdo clínico).
model Lembrete {
  id                  String         @id @default(uuid())
  idConsulta          String         @unique @map("id_consulta")
  pacienteNome        String         @map("paciente_nome")
  pacienteCpf         String?        @map("paciente_cpf")
  telefone            String
  profissional        String
  especialidade       String
  inicioConsulta      DateTime       @map("inicio_consulta") @db.Timestamptz(3)
  enviarEm            DateTime       @map("enviar_em") @db.Timestamptz(3)
  antecedenciaMinutos Int?           @map("antecedencia_minutos")
  idEventoConsulta    String?        @map("id_evento_consulta")
  status              StatusLembrete @default(programado)
  tentativas          Int            @default(0)
  motivoFalha         String?        @map("motivo_falha")
  enviadoEm           DateTime?      @map("enviado_em") @db.Timestamptz(3)
  modoEnvio           ModoEnvio?     @map("modo_envio")
  canalEnvio          CanalLembrete? @map("canal_envio")
  idExterno           String?        @map("id_externo")
  /// US-11: sequência do último evento de consulta aplicado; nulo quando só eventos sem sequência foram recebidos.
  sequenciaAplicada   Int?           @map("sequencia_aplicada")
  criadoEm            DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm        DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@index([status, enviarEm])
  @@index([pacienteCpf])
  @@map("lembretes")
}

/// Projeção local do mestre. A revisão impede eventos antigos de desfazer correções.
model ContatoPaciente {
  cpf      String @id
  nome     String
  telefone String
  revisao  Int

  @@map("contatos_pacientes")
}

/// Cópia local da autorização de contato por CPF e canal, vinda de paciente.autorizacao_alterada.
/// Só versão maior substitui a guardada. Sem linha, a autorização é desconhecida e o envio é bloqueado.
model AutorizacaoContato {
  cpf          String
  canal        String
  idPaciente   String   @map("id_paciente")
  situacao     String
  versao       Int
  registradoEm DateTime @map("registrado_em") @db.Timestamptz(3)
  recebidoEm   DateTime @default(now()) @map("recebido_em") @db.Timestamptz(3)

  @@id([cpf, canal])
  @@index([idPaciente])
  @@map("autorizacoes_contato")
}

/// Idempotência do consumidor: cada id_evento é processado uma única vez.
model EventoProcessado {
  idEvento     String   @id @map("id_evento")
  tipo         String
  processadoEm DateTime @default(now()) @map("processado_em") @db.Timestamptz(3)

  @@map("eventos_processados")
}

/// O que o serviço fez, em ordem: alimenta o painel "Eventos em tempo real" da recepção.
model Atividade {
  id         String   @id @default(uuid())
  acao       String
  descricao  String
  idEvento   String?  @map("id_evento")
  idConsulta String?  @map("id_consulta")
  ocorridoEm DateTime @default(now()) @map("ocorrido_em") @db.Timestamptz(3)

  @@index([ocorridoEm])
  @@map("atividades")
}

enum ResultadoReprocessamento {
  solicitado
  republicado
  falhou
}

/// Cada solicitação explícita de reprocessamento de uma mensagem da fila de erros. Não guarda o conteúdo da mensagem.
model Reprocessamento {
  id           String                   @id @default(uuid())
  idEvento     String                   @map("id_evento")
  tipo         String?
  idConsulta   String?                  @map("id_consulta")
  solicitante  String
  resultado    ResultadoReprocessamento @default(solicitado)
  solicitadoEm DateTime                 @default(now()) @map("solicitado_em") @db.Timestamptz(3)

  @@index([idEvento])
  @@map("reprocessamentos")
}
