    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@clinica/eventos": "*",
    "@prisma/client": "^6.19.3",
    "amqplib": "^2.2.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15"
  }
}
