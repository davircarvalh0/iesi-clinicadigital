generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusConsulta {
  agendada
  cancelada
}

model Profissional {
  id String @id @default(uuid())
  nome String @unique
  especialidade String
  consultas Consulta[]
  @@map("profissionais")
}

model Consulta {
  id               String         @id @default(uuid())
  idPaciente       String?        @map("id_paciente")
  vinculoPacientePendente Boolean @default(false) @map("vinculo_paciente_pendente")
  pacienteNome     String         @map("paciente_nome")
  pacienteCpf      String         @map("paciente_cpf")
  pacienteTelefone String         @map("paciente_telefone")
  pacienteRevisao  Int?           @map("paciente_revisao")
  /// US-11: incrementada a cada remarcação e cancelamento, na mesma transação do evento.
  sequencia        Int            @default(1)
  profissional     String
  profissionalId   String @map("profissional_id")
  vinculoProfissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  especialidade    String
  inicio           DateTime       @db.Timestamptz(3)
  status           StatusConsulta @default(agendada)
  criadoEm         DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@index([inicio])
  @@index([profissionalId])
  @@map("consultas")
}

model EventoProcessado {
  idEvento String @id @map("id_evento")

  @@map("eventos_processados")
}

/// Outbox: o evento é gravado na mesma transação da consulta e publicado depois pelo publicador.
/// Um reenvio de demonstração cria outra linha com o mesmo id_evento (duplicado = true).
model EventoSaida {
  id          String    @id @default(uuid())
  idEvento    String    @map("id_evento")
  tipo        String
  envelope    Json
  duplicado   Boolean   @default(false)
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  publicadoEm DateTime? @map("publicado_em") @db.Timestamptz(3)
  tentativas  Int       @default(0)
  ultimoErro  String?   @map("ultimo_erro")

  @@index([publicadoEm, criadoEm])
  @@index([idEvento])
  @@map("outbox")
}
