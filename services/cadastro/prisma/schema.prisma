generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Paciente {
  id            String   @id @default(uuid())
  cpf           String   @unique
  nome          String
  telefone      String
  email         String?
  nascimento    DateTime? @db.Date
  convenio      String?   @db.VarChar(120)
  canalPreferido CanalContato? @map("canal_preferido")
  revisao       Int      @default(1)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  autorizacoes  AutorizacaoContato[]

  @@map("pacientes")
}

enum CanalContato {
  whatsapp
  sms
  email
}

enum SituacaoAutorizacao {
  autorizado
  revogado
}

enum OrigemAutorizacao {
  presencial
  telefone
  formulario
}

/// Histórico de autorizações e revogações (só cresce). A situação atual de um canal é a maior versão;
/// sem registro, o canal não está autorizado.
model AutorizacaoContato {
  id           String              @id @default(uuid())
  idPaciente   String              @map("id_paciente")
  paciente     Paciente            @relation(fields: [idPaciente], references: [id])
  canal        CanalContato
  situacao     SituacaoAutorizacao
  origem       OrigemAutorizacao
  versao       Int
  registradoEm DateTime            @default(now()) @map("registrado_em") @db.Timestamptz(3)

  @@unique([idPaciente, canal, versao])
  @@map("autorizacoes_contato")
}

model EventoProcessado {
  idEvento     String   @id @map("id_evento")
  tipo         String
  processadoEm DateTime @default(now()) @map("processado_em") @db.Timestamptz(3)

  @@map("eventos_processados")
}

model EventoSaida {
  idEvento    String    @id @map("id_evento")
  tipo        String
  envelope    Json
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  publicadoEm DateTime? @map("publicado_em") @db.Timestamptz(3)

  @@index([publicadoEm, criadoEm])
  @@map("eventos_saida")
}
