generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario {
  administrador
  recepcionista
  profissional
  paciente
}

model Usuario {
  id String @id @default(uuid())
  nome String
  email String @unique
  senhaHash String @map("senha_hash")
  perfil PerfilUsuario
  profissionalId String? @map("profissional_id")
  /// US-27: conta do portal ligada a um paciente do cadastro mestre (uma conta por paciente).
  pacienteId String? @unique @map("paciente_id")
  paciente Paciente? @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  ativo Boolean @default(true)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  sessoes Sessao[]
  redefinicoes RedefinicaoSenha[]
  @@map("usuarios")
}

/// US-25: cada login abre uma sessão. Logout, troca de senha, mudança de perfil e desativação a encerram.
model Sessao {
  id String @id @default(uuid())
  usuarioId String @map("usuario_id")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)
  expiraEm DateTime @map("expira_em") @db.Timestamptz(3)
  encerradaEm DateTime? @map("encerrada_em") @db.Timestamptz(3)
  @@index([usuarioId])
  @@map("sessoes")
}

/// US-25: pedido de recuperação de senha. Só o hash do código é guardado; o código vale uma vez.
model RedefinicaoSenha {
  id String @id @default(uuid())
  usuarioId String @map("usuario_id")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String @unique @map("codigo_hash")
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)
  expiraEm DateTime @map("expira_em") @db.Timestamptz(3)
  usadaEm DateTime? @map("usada_em") @db.Timestamptz(3)
  @@index([usuarioId])
  @@map("redefinicoes_senha")
}

model Paciente {
  id            String   @id @default(uuid())
  cpf           String   @unique
  nome          String
  telefone      String
  email         String?
  nascimento    DateTime? @db.Date
  convenio      String?   @db.VarChar(120)
  canalPreferido CanalContato? @map("canal_preferido")
  revisao       Int      @default(1)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  autorizacoes  AutorizacaoContato[]
  conta         Usuario?

  @@map("pacientes")
}

enum CanalContato {
  whatsapp
  sms
  email
}

enum SituacaoAutorizacao {
  autorizado
  revogado
}

enum OrigemAutorizacao {
  presencial
  telefone
  formulario
}

/// Histórico de autorizações e revogações (só cresce). A situação atual de um canal é a maior versão;
/// sem registro, o canal não está autorizado.
model AutorizacaoContato {
  id           String              @id @default(uuid())
  idPaciente   String              @map("id_paciente")
  paciente     Paciente            @relation(fields: [idPaciente], references: [id])
  canal        CanalContato
  situacao     SituacaoAutorizacao
  origem       OrigemAutorizacao
  versao       Int
  registradoEm DateTime            @default(now()) @map("registrado_em") @db.Timestamptz(3)

  @@unique([idPaciente, canal, versao])
  @@map("autorizacoes_contato")
}

model EventoProcessado {
  idEvento     String   @id @map("id_evento")
  tipo         String
  processadoEm DateTime @default(now()) @map("processado_em") @db.Timestamptz(3)

  @@map("eventos_processados")
}

model EventoSaida {
  idEvento    String    @id @map("id_evento")
  tipo        String
  envelope    Json
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  publicadoEm DateTime? @map("publicado_em") @db.Timestamptz(3)

  @@index([publicadoEm, criadoEm])
  @@map("eventos_saida")
}
