{
  "name": "iesi-clinicadigital",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @clinica/eventos && npm run prisma:generate --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integracao": "node --test scripts/us07.integracao.test.mjs",
    "test:us08": "node --test scripts/us08.integracao.test.mjs",
    "dev:agendamento": "npm run dev -w @clinica/agendamento",
    "dev:notificacao": "npm run dev -w @clinica/notificacao",
    "dev:cadastro": "npm run dev -w @clinica/cadastro",
    "dev:recepcao": "npm run dev -w @clinica/recepcao",
    "infra": "docker compose up -d rabbitmq db-agendamento db-notificacao db-cadastro",
    "demo:popular": "node scripts/popular-demo.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^24.19.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
